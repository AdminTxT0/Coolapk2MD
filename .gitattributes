* text=auto

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# C# / Python / Markdown 使用 LF
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf